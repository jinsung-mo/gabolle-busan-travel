# 이 폴더에서 깃에 올리는 것은 **코드와 작은 산출물뿐**이다.
# 구운 타일·지형·배포 꾸러미는 807 MB 인데 전부 스크립트로 다시 만들 수 있다.
#
# 🔴 LFS 를 쓰지 않는다. LFS 도 저장소가 그만큼 무거워지는 건 똑같고 clone 이 느려진다.
#    큰 파일은 **AWS(EC2)에 두고 주소로 부른다.**
#
#    새로 clone 했다면 굽지 말고 이렇게 바로 볼 수 있다:
#      node serve.mjs
#      http://localhost:8787/?data=aws
#    ?data=aws 를 붙이면 타일과 지형을 https://j15e201.p.ssafy.io/city3d 에서 받는다.
#    직접 구우려면 아래 각 항목의 명령을 쓴다.

node_modules/

# 부산 전역을 굽고 남은 중간 산출물. busan.geojson 하나가 141 MB 다.
#   다시 만들기: node night.mjs   (건물 47만 동 → 타일, 땅 높이 축소본)
work/

# 구운 건물 타일과 땅 높이. 합쳐서 124 MB.
#   다시 만들기: node night.mjs
#
# 🔴 땅 높이 축소본(public/dem-tiles)의 재료는 **정리본 z15** 다 (S15P21E201-805).
#    없으면 night.mjs 가 멈춘다. 먼저 이 순서로 만든다:
#      cd ../bigData && node collect/terrain.mjs   원본 z15 를 받는다 (3,127장)
#      cd ../city3d-spike && node dem-clean-tiles.mjs   가짜 능선을 걷어낸 정리본을 굽는다
#      node night.mjs --dem-only                   그 정리본으로 확대 11~14 단계를 줄인다
public/tiles/
public/tiles-busan/
public/dem-tiles/

# 서버에 올릴 한 폴더로 모은 것. 262 MB, 위의 것들을 복사한 결과다.
#   다시 만들기: node build-dist.mjs
dist/
*.tar.gz

# 확인용 브라우저가 남기는 것
.playwright-mcp/
*.png

# 🔴 브이월드 인증키. config.example.js 를 config.local.js 로 복사해 만든다. 한 줄도 커밋하지 않는다.
#    없으면 항공사진만 꺼지고 나머지는 그대로 돈다.
public/config.local.js
