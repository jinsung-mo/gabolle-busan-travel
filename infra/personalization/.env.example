# 실제 값은 이 파일에 채우지 않는다. 서버의 /etc/local-route/personalization.env 에만 둔다
# (0640 권한, root:배포그룹). 이 파일은 어떤 항목이 필요한지 보여주는 목록일 뿐이다.

POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=
AIRFLOW_DB_PASSWORD=
MLFLOW_DB_PASSWORD=

REDIS_PASSWORD=

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# Fernet 키는 반드시 `python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"` 로 생성한다
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET=
AIRFLOW_BROKER_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
