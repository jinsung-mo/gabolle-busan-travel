# Spring profile
SPRING_PROFILES_ACTIVE=dev

# Recommendation service/deployment identity. No default in application-dev.properties
# on purpose (S15P21E201-604) — these are for local runs only.
GABOLLE_SERVICE_VERSION=local-dev
GABOLLE_DEPLOYMENT_ENVIRONMENT=local

# Docker Compose PostgreSQL
POSTGRES_DB=gabolle
POSTGRES_USER=gabolle
POSTGRES_PASSWORD=change-me
BACKEND_PORT=8080

# PostgreSQL
GABOLLE_DB_URL=jdbc:postgresql://localhost:5432/gabolle
GABOLLE_DB_USERNAME=gabolle
GABOLLE_DB_PASSWORD=change-me
GABOLLE_DB_SCHEMA=gabolle

# JWT signing secret (generate a long random value)
GABOLLE_JWT_SECRET=change-me-to-a-long-random-secret
GABOLLE_AUTH_REQUEST_COOLDOWN=60s
GABOLLE_OAUTH_CHALLENGE_TTL=5m
GABOLLE_OAUTH_ALLOWED_REDIRECT_URIS=https://j15e201.p.ssafy.io/oauth/google/callback,https://j15e201.p.ssafy.io/oauth/naver/callback,https://j15e201.p.ssafy.io/oauth/kakao/callback
GABOLLE_CORS_ALLOWED_ORIGINS=https://j15e201.p.ssafy.io,http://localhost:3000,http://localhost:5173
GABOLLE_WEB_REFRESH_COOKIE_SECURE=false
GABOLLE_WEB_REFRESH_COOKIE_SAME_SITE=Strict
GABOLLE_AGE_GATE_POLICY_VERSION=2026-01
GABOLLE_CONSENT_POLICY_VERSION=2026-01

# SMTP / Gmail app password
GABOLLE_MAIL_ENABLED=false
GABOLLE_MAIL_HOST=smtp.gmail.com
GABOLLE_MAIL_PORT=587
GABOLLE_MAIL_USERNAME=your-sender@gmail.com
GABOLLE_MAIL_PASSWORD=your-app-password
GABOLLE_MAIL_FROM=your-sender@gmail.com

# OAuth provider server credentials. Never commit real values.
GABOLLE_GOOGLE_CLIENT_ID=
GABOLLE_GOOGLE_CLIENT_SECRET=
GABOLLE_GOOGLE_ALLOWED_CLIENT_IDS=
GABOLLE_GOOGLE_ISSUER=https://accounts.google.com
GABOLLE_GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
# Naver Developers application credentials.
GABOLLE_NAVER_CLIENT_ID=
GABOLLE_NAVER_CLIENT_SECRET=
# Kakao REST API key is the client_id. Client secret is required when the
# Client secret feature is enabled in Kakao Developers (the default setting).
GABOLLE_KAKAO_CLIENT_ID=
GABOLLE_KAKAO_CLIENT_SECRET=

# Claude API key for the natural-language assistant (S15P21E201-802).
# Leave EMPTY to keep it running — calls fail with a clear 502 instead of fake data.
GABOLLE_ASSISTANT_API_KEY=

# Internal batch API token (MLOps Phase 1). Machine-to-machine only; Airflow sends it as
# X-Internal-Token. Generate with `openssl rand -hex 32`.
# Leave EMPTY to keep /internal/** fully closed — the filter grants no authority without it.
GABOLLE_INTERNAL_API_TOKEN=
