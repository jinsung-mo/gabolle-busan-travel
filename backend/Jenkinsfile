// backend-deploy 파이프라인 (S15P21E201-575)
//
// Jenkins Job 설정:
//  - Definition: Pipeline script from SCM
//  - SCM: Git, branch back/dev, credentialsId gitlab-pat
//  - Script Path: backend/Jenkinsfile
//  - Triggers: Generic Webhook Trigger, token = backend-deploy
//    (GitLab Webhook의 Wildcard pattern을 back/dev 로 제한해서 등록)
//
// 필요한 Jenkins Credentials:
//  - gitlab-pat            (Username with password) — GitLab 저장소 체크아웃
//  - mattermost-webhook    (Secret text) — 빌드 결과 알림용 MatterMost Incoming Webhook URL
//  - gabolle-db-url        (Secret text) — jdbc:postgresql://postgres:5432/app_db
//  - gabolle-db-username   (Secret text) — app_user
//  - gabolle-db-password   (Secret text)
//  - gabolle-jwt-secret    (Secret text) — 32자 이상 운영용 값
//
// DB는 infra/personalization의 PostgreSQL(app_db, S15P21E201-581)을 그대로
// 쓴다 — 그래서 컨테이너를 그 Docker 네트워크(local-route-personalization_data_net)에
// 같이 붙여야 "postgres" 호스트명이 풀린다. 이 컨테이너가 그 compose 프로젝트
// 소속은 아니지만, 네트워크 이름으로 조인만 하면 같은 DNS를 쓸 수 있다.

pipeline {
    agent any

    environment {
        // 🔴 컨테이너를 직접 본다. nginx 를 지나가지 않는다.
        //
        //    이 값은 'https://j15e201.p.ssafy.io/api/actuator/health' 였다. 그 주소는
        //    200 을 줄 수 없다 — 이 앱에는 context-path 가 없고(설정 없음) 컨트롤러가
        //    @RequestMapping("/api/v1/...") 로 직접 매핑되어 있다. actuator 는 기본값인
        //    /actuator 아래에 있으므로 Spring 에서 /api/actuator/health 는 404 다.
        //    즉 앱이 완전히 정상이어도 Health Check 단계가 12번 재시도 후 실패했고,
        //    배포가 늘 실패로 표시되며 MatterMost 에도 실패가 갔다.
        //
        //    🔴 밖에서 https://j15e201.p.ssafy.io/actuator/health 를 열면 200 이 오는데
        //    그것은 앱이 아니다. nginx 의 SPA fallback 이 Expo 웹 index.html 을 준다.
        //    그 200 을 백엔드가 살아 있다는 증거로 쓰면 안 된다.
        //
        //    컨테이너를 직접 보면 (1) 프록시·정적 fallback 에 속지 않고 (2) actuator 를
        //    외부에 노출하지 않아도 된다.
        //
        //    🔴 정정 (2026-09-03) — localhost 는 틀렸다. Jenkins 자신이 컨테이너로
        //    떠 있다 (docs/SERVER-SETUP.md 5절 — docker run --name jenkins ...).
        //    agent any 라 이 스텝도 Jenkins 컨테이너 안에서 돈다. 그 안의 localhost 는
        //    backend 컨테이너가 아니라 Jenkins 자기 자신이다 — 이미 5절에 적힌 함정
        //    그대로다 ("다른 컨테이너와는 별개의 네트워크 네임스페이스").
        //
        //    컨테이너 이름 backend 로 대신 가리킨다. DNS 로 풀리려면 Jenkins 가
        //    backend 와 같은 도커 네트워크(local-route-personalization_data_net)에
        //    있어야 한다 — 위 18~21행의 postgres 호스트명과 같은 이유다.
        //    한 번만: docker network connect local-route-personalization_data_net jenkins
        HEALTH_URL = 'http://backend:8080/actuator/health'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'back/dev',
                    credentialsId: 'gitlab-pat',
                    url: 'https://lab.ssafy.com/s15-bigdata-dist-sub1/S15P21E201.git'
            }
        }

        stage('Build Image') {
            steps {
                dir('backend') {
                    sh 'docker build -t local-route-backend .'
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([
                    string(credentialsId: 'gabolle-db-url', variable: 'GABOLLE_DB_URL'),
                    string(credentialsId: 'gabolle-db-username', variable: 'GABOLLE_DB_USERNAME'),
                    string(credentialsId: 'gabolle-db-password', variable: 'GABOLLE_DB_PASSWORD'),
                    string(credentialsId: 'gabolle-jwt-secret', variable: 'GABOLLE_JWT_SECRET')
                ]) {
                    sh 'docker stop backend || true'
                    sh 'docker rm backend || true'
                    sh '''
                        docker run -d --name backend \
                            --network local-route-personalization_data_net \
                            -p 8080:8080 \
                            -e SPRING_PROFILES_ACTIVE=dev \
                            -e GABOLLE_DB_URL="$GABOLLE_DB_URL" \
                            -e GABOLLE_DB_USERNAME="$GABOLLE_DB_USERNAME" \
                            -e GABOLLE_DB_PASSWORD="$GABOLLE_DB_PASSWORD" \
                            -e GABOLLE_JWT_SECRET="$GABOLLE_JWT_SECRET" \
                            local-route-backend
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                script {
                    // 🔴 2026-09-03 — curl이 연결 자체에 실패하면(exit 7, 앱이 아직
                    //    포트를 안 열었을 때 흔하다) sh 스텝이 비정상 종료로 보고
                    //    재시도 없이 파이프라인을 즉시 죽였다. HEALTH_URL이 nginx나
                    //    Jenkins 자신을 가리키던 동안은 "연결은 되고 코드만 틀림"만
                    //    있어서 이 버그가 드러나지 않았는데, 컨테이너를 직접 찌르니
                    //    (S15P21E201-574) 기동 중 포트가 아직 안 열린 순간 처음
                    //    드러났다. `|| echo 000`으로 curl 실패도 코드값 하나로
                    //    바꿔서, 재시도 루프가 진짜로 12번을 다 쓰게 한다.
                    def healthy = false
                    for (int i = 0; i < 12; i++) {
                        def code = sh(script: "curl -s -o /dev/null -w '%{http_code}' ${HEALTH_URL} || echo 000", returnStdout: true).trim()
                        if (code == '200') {
                            healthy = true
                            break
                        }
                        sleep 5
                    }
                    if (!healthy) {
                        error 'Health check failed after retries'
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                sendMMNotify(true, [
                    commit: sh(script: "git log -1 --pretty='%an: %s'", returnStdout: true).trim(),
                    buildUrl: env.BUILD_URL
                ])
            }
        }
        failure {
            script {
                sendMMNotify(false, [
                    commit: sh(script: "git log -1 --pretty='%an: %s'", returnStdout: true).trim(),
                    buildUrl: env.BUILD_URL,
                    details: 'Console Output 을 확인하세요'
                ])
            }
        }
    }
}

// MatterMost 알림 전송
def sendMMNotify(boolean success, Map info) {
    def titleLine = success
        ? '#### :white_check_mark: 백엔드(back/dev) 배포 성공'
        : '#### :x: 백엔드(back/dev) 배포 실패'

    def lines = []
    if (info.commit)   lines << "**커밋**: ${info.commit}"
    if (info.buildUrl) lines << "**빌드 상세**: [Details](${info.buildUrl})"
    if (!success && info.details) lines << "**참고**: ${info.details}"

    def text = lines ? "${titleLine}\n" + lines.join("\n") : titleLine

    writeFile file: 'mm_payload.json', text: groovy.json.JsonOutput.toJson([
        text: text,
        username: 'Jenkins',
        icon_emoji: ':jenkins7:'
    ])

    withCredentials([string(credentialsId: 'mattermost-webhook', variable: 'MM_WEBHOOK')]) {
        sh '''
            curl -sS -f -X POST -H 'Content-Type: application/json' \
                --data-binary @mm_payload.json \
                "$MM_WEBHOOK" || true
        '''
    }
}
