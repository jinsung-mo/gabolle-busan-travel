      "definition": { "ko": "머물러 쉬거나 노는 곳. 체류시간이 길어 다음 Leg 의 시각을 크게 밀어낸다." },
      "codeList": ["leisure=park", "leisure=garden", "leisure=playground", "leisure=marina", "leisure=nature_reserve", "leisure=sports_centre", "leisure=swimming_pool", "leisure=water_park", "leisure=golf_course", "leisure=stadium", "leisure=sauna", "leisure=amusement_arcade", "leisure=bowling_alley", "leisure=bird_hide", "tourism=picnic_site", "amenity=public_bath"],
