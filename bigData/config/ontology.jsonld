      "definition": { "ko": "박물관·미술관·공연장·유적처럼 안에 들어가 보는 곳. 휴관일이 있는 갈래라 요일이 판정에 들어온다." },
      "codeList": ["tourism=museum", "tourism=gallery", "tourism=artwork", "tourism=attraction", "tourism=theme_park", "tourism=zoo", "tourism=aquarium", "tourism=observatory", "amenity=arts_centre", "amenity=theatre", "amenity=cinema", "amenity=exhibition_centre", "amenity=events_venue", "amenity=place_of_worship", "historic=monument", "historic=memorial", "historic=city_gate"],
