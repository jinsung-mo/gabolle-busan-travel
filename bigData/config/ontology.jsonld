    },
    {
      "@id": "bm:RuleElderlySlope",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:FeasibilityRule",
      "prefLabel": { "ko": "고령자 — 경사 상한 초과", "en": "Elderly — slope over limit" },
      "definition": { "ko": "대표 경사가 고령자 상한을 넘는 구간은 지날 수 없다." },
      "appliesTo": "bm:Elderly",
      "onClass": "bm:Segment",
      "condition": [{ "property": "bm:slopeP90", "operator": "gte", "parameter": "bm:maxSlopeElderly" }],
      "verdict": "infeasible",
      "evidenceStatus": "임계미정"
    },

    {
      "@id": "bm:RuleWheelchairLegSteps",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:FeasibilityRule",
      "prefLabel": { "ko": "휠체어 — 이동 안에 계단 구간", "en": "Wheelchair — a stepped segment inside the leg" },
      "definition": { "ko": "지나는 구간 중 하나라도 계단이 있으면 그 이동 전체를 휠체어가 할 수 없다." },
      "note": { "ko": "구간 규칙(bm:RuleWheelchairSteps)과 같은 말을 이동 단위에서 한 번 더 하는 것이다. 사용자가 고르는 것은 구간이 아니라 이동이기 때문에, 판정도 이동 단위로 나와야 '이 이동은 안 됩니다' 라고 말할 수 있다." },
      "appliesTo": "bm:Wheelchair",
      "onClass": "bm:Leg",
      "condition": [{ "property": "bm:legHasStepSegment", "operator": "eq", "constant": true }],
      "verdict": "infeasible",
      "evidenceStatus": "입력미수집"
    },
    {
      "@id": "bm:RuleStrollerLegSteps",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:FeasibilityRule",
      "prefLabel": { "ko": "유모차 — 이동 안에 계단 구간", "en": "Stroller — a stepped segment inside the leg" },
      "definition": { "ko": "지나는 구간 중 하나라도 계단이 있으면 그 이동 전체를 유모차가 할 수 없다." },
      "appliesTo": "bm:Stroller",
      "onClass": "bm:Leg",
      "condition": [{ "property": "bm:legHasStepSegment", "operator": "eq", "constant": true }],
      "verdict": "infeasible",
      "evidenceStatus": "입력미수집"
    },
    {
      "@id": "bm:RuleWheelchairEntranceNoElevator",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:FeasibilityRule",
      "prefLabel": { "ko": "휠체어 — 승강기 없는 출입구", "en": "Wheelchair — entrance without an elevator" },
      "definition": { "ko": "엘리베이터가 없는 도시철도 출입구는 휠체어가 이용할 수 없다." },
      "note": {
        "ko": "🔴 확인 전에 이 값으로 사용자에게 '이 출구로는 못 들어갑니다' 라고 말하면 안 된다. 출입구 번호가 안 적힌 엘리베이터가 따로 세어져 있어서, 거짓이 '승강기가 없다' 인지 '번호가 안 적혔다' 인지 아직 갈리지 않았다. 모름(null)은 이 규칙에 걸리지 않는다 — 산출물이 거짓과 모름을 이미 구분해 두었다."
      },
      "appliesTo": "bm:Wheelchair",
      "onClass": "bm:StationEntrance",
      "condition": [{ "property": "bm:exitElevatorAvailable", "operator": "eq", "constant": false }],
      "verdict": "infeasible",
      "evidenceStatus": "검증필요"
    },

    {
      "@id": "bm:MetaProperty",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "topConceptOf": "bm:MobilityScheme",
      "prefLabel": { "ko": "메타 술어", "en": "Meta property" },
      "definition": {
        "ko": "이 파일 자체를 기술하는 술어. 각 술어의 @id 가 곧 그 술어의 URI 이므로, 여기 적힌 codeList 는 검사기가 실제 사용값을 대조하는 데 그대로 쓰인다.",
        "en": "A predicate describing this document itself; each node's @id is the predicate URI, so its codeList is what the checker enforces."
      }
    },
    {
      "@id": "bm:role",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:MetaProperty",
      "prefLabel": { "ko": "속성의 쓰임", "en": "Attribute role" },
      "definition": { "ko": "이 속성이 판정에서 무엇으로 쓰이는가. feasibility 는 가능/불가를 가르고, cost 는 비용함수의 입력이며 계수는 이 파일에 없다." },
      "codeList": ["identifier", "feasibility", "cost", "descriptive"],
      "codeListOpen": false
    },
    {
      "@id": "bm:status",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:MetaProperty",
      "prefLabel": { "ko": "수집 상태", "en": "Collection status" },
      "definition": { "ko": "이 개념의 실제 데이터가 지금 있는가. 미수집이면 필드 이름을 적지 않는다 — 지어낸 이름은 실제 응답과 어긋나고 그것이 이 파트에서 가장 나쁜 실패다." },
      "codeList": ["수집됨", "부분수집", "미수집", "파생"],
      "codeListOpen": false
    },
    {
      "@id": "bm:unit",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:MetaProperty",
      "prefLabel": { "ko": "단위", "en": "Unit" },
      "definition": { "ko": "값의 단위 코드. 단위가 없는 속성은 대신 valueRange 나 codeList 를 갖는다." },
      "note": { "ko": "unitIri 는 QUDT 로 확실히 대응되는 단위에만 붙였다. ms 처럼 IRI 를 확인하지 못한 것은 코드만 남기고 IRI 를 비웠다 — 틀린 IRI 를 적는 것보다 낫다. h(시)와 degC(섭씨)는 여행 상위 개념을 얹으면서 늘렸다 — 코드목록이 닫혀 있어서 새 단위를 쓰려면 여기를 먼저 늘려야 하고, 그것이 이 목록의 설계 의도다." },
      "codeList": ["m", "km", "ratio", "count", "min", "ms", "h", "degC"],
      "codeListOpen": false
    },
    {
      "@id": "bm:isTemporal",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:MetaProperty",
      "prefLabel": { "ko": "시각 축 표시", "en": "Temporal axis flag" },
      "definition": { "ko": "이 속성이 '언제인가' 를 담는가. 시각에 따라 답이 달라지는 층(그림자·영업시간·첫차막차·기온)이 붙을 자리를 이 표시로 찾는다." },
      "note": { "ko": "🔴 이 표시가 하나도 없으면 bm:Leg 이 시각을 갖지 않는다는 뜻이고, test/verify-ontology.mjs 가 종료 코드 1 로 막는다. 이름으로 찾지 않고 표시로 찾는 이유는, 속성 이름을 바꿔도 검사가 안 무너지게 하기 위해서다." },
      "codeList": [true, false],
      "codeListOpen": false
    },
    {
      "@id": "bm:operator",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:MetaProperty",
      "prefLabel": { "ko": "비교 연산자", "en": "Comparison operator" },
      "definition": { "ko": "규칙 조건이 속성값과 임계값을 어떻게 비교하는가. in 은 값이 목록에 들어 있는지를 본다." },
      "codeList": ["eq", "lt", "lte", "gt", "gte", "in"],
      "codeListOpen": false
    },
    {
      "@id": "bm:verdict",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:MetaProperty",
      "prefLabel": { "ko": "판정", "en": "Verdict" },
      "definition": { "ko": "규칙이 맞았을 때의 결론. 점수가 아니라 둘 중 하나다." },
      "codeList": ["infeasible", "feasible"],
      "codeListOpen": false
    },
    {
      "@id": "bm:evidenceStatus",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:MetaProperty",
      "prefLabel": { "ko": "규칙 가동 상태", "en": "Rule readiness" },
      "definition": { "ko": "이 규칙을 지금 돌릴 수 있는가. 적용가능이 아니면 무엇이 없어서 못 돌리는지를 이름이 말한다 — 입력미수집은 데이터가, 임계미정은 파라미터 값이, 검증필요는 필드 의미가 없다는 뜻이다." },
      "codeList": ["적용가능", "임계미정", "입력미수집", "검증필요"],
      "codeListOpen": false
    },
    {
      "@id": "bm:coefficientStatus",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:MetaProperty",
      "prefLabel": { "ko": "선호 계수 상태", "en": "Preference coefficient status" },
      "definition": { "ko": "비용함수 입력 속성의 계수 자리. 코드가 미추정 하나뿐인 것은 의도다 — 이 파일에 계수 숫자를 넣을 수 없게 만든 것이다." },
      "note": { "ko": "🔴 계수는 손으로 정하지 않고 사람에게서 추정한다 (docs/FIELD-STUDY.md). 여기에 숫자를 박으면 그 결정을 뒤집는 것이고, test/verify-ontology.mjs 가 종료 코드 1 로 막는다." },
      "codeList": ["미추정"],
      "codeListOpen": false
    },
    {
      "@id": "bm:ModeRentalCar",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:TravelMode",
      "prefLabel": { "ko": "렌터카", "en": "Rental car" },
      "definition": { "ko": "빌린 차로 가는 것. 외국인 이용자에게는 운전면허 인정 여부가 먼저 걸린다." },
      "note": { "ko": "🔴 ModeTaxi 와 같다 — 열거값만 열어 둔다. 요금·소요시간 데이터가 없으므로 지어내지 않는다." }
    },
    {
      "@id": "bm:DriverForeignPermit",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:UserProfile",
      "prefLabel": { "ko": "외국 면허 운전자", "en": "Driver with a foreign permit" },
      "definition": {
        "ko": "국내 면허가 없고 본국 면허나 국제운전면허증(IDP)으로 운전하려는 이용자.",
        "en": "A user driving on a foreign licence or International Driving Permit rather than a Korean licence."
      },
      "note": { "ko": "이동 능력이 아니라 자격으로 갈리는 프로파일이다. 휠체어·유모차와 축이 다르므로 함께 켤 수 있다." }
    },
    {
      "@id": "bm:permitRecognizedKR",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:Leg",
      "prefLabel": { "ko": "국내 면허 인정 여부", "en": "Permit recognised in Korea" },
      "definition": { "ko": "이 이용자가 가진 운전 자격이 대한민국에서 인정되는가." },
      "note": {
        "ko": "🔴 값을 정하는 것은 이용자의 면허 발급국과 협약 가입 여부다. 대한민국은 1949년 제네바협약 IDP 를 인정하고 1968년 비엔나협약 IDP 는 인정하지 않는다고 알려져 있으나, 국가별 목록은 아직 확보하지 않았다. 목록은 이 파일이 아니라 데이터로 간다 — 협약 가입국은 바뀌기 때문이다."
      },
      "valueRange": { "kind": "코드 — recognized · notRecognized · unknown" },
      "role": "feasibility"
    },
    {
      "@id": "bm:RuleRentalCarPermitUnrecognized",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:FeasibilityRule",
      "prefLabel": { "ko": "렌터카 — 면허 미인정", "en": "Rental car — permit not recognised" },
      "definition": { "ko": "운전 자격이 국내에서 인정되지 않으면 렌터카로 가는 구간은 성립하지 않는다." },
      "note": {
        "ko": "🔴 이것은 취향이 아니라 자격이다. 빌려주지 않으므로 누가 물어도 답이 같다 — 계단 앞의 휠체어와 같은 자리다. 그리고 현지에서 해결할 수 없다(IDP 는 본국에서만 발급된다). 그래서 여행 계획 단계에서 미리 말해 줘야 값이 있다."
      },
      "appliesTo": "bm:DriverForeignPermit",
      "onClass": "bm:Leg",
      "condition": [{ "property": "bm:permitRecognizedKR", "operator": "eq", "constant": "notRecognized" }],
      "verdict": "infeasible",
      "evidenceStatus": "입력미수집"
    },
    {
      "@id": "bm:transferWindowMin",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Parameter",
      "prefLabel": { "ko": "환승 할인 시간창", "en": "Transfer discount window" },
      "definition": { "ko": "앞 교통수단에서 내린 뒤 이 시간 안에 다시 타야 환승 할인이 적용된다." },
      "unit": "min",
      "valueRange": { "minInclusive": 0, "kind": "분" },
      "valueStatus": "미정",
      "valueBasis": "🔴 여행 안내 글에서 30분이라는 값을 보았을 뿐, 부산시·부산교통공사의 공식 요금 규정으로 확인하지 못했다. 시간대별로 다를 수 있다는 이야기도 있어 한 값으로 박을 수 없다. 확인 전에는 비워 둔다.",
      "note": {
        "ko": "🔴 이 값으로 가능판정 규칙을 만들지 않았다. 환승 할인을 놓치는 것은 돈을 더 내는 일이지 지나갈 수 없는 일이 아니다. bm:verdict 는 infeasible·feasible 둘뿐이고, 요금 손해를 infeasible 로 적으면 0절에서 그은 선을 넘는다. 이 값은 비용 계산이 쓴다."
      }
    },
    {
      "@id": "bm:DietScheme",
      "@type": "skos:ConceptScheme",
      "prefLabel": { "ko": "부산 식이 제약 어휘", "en": "Busan Dietary Constraint Vocabulary" },
      "definition": {
        "ko": "'이 가게에서 먹을 수 있는가' 를 판정하기 위한 개념·속성·가능판정 규칙의 모음.",
        "en": "Concepts, attributes and feasibility rules used to judge whether a user can eat at a place."
      },
      "note": {
        "ko": "🔴 이동성 어휘와 같은 선을 긋는다 — 먹을 수 있나 없나만 담고, 맛있나 없나는 담지 않는다. 알레르기·종교 제약은 취향이 아니라 제약이다. 지금은 알레르기만 들어 있다. 할랄·채식은 같은 자리에 같은 모양으로 들어갈 수 있게 열어 둔 것이고, 아직 넣지 않았다 — 인증 명부를 확보하지 못했다."
      }
    },
    {
      "@id": "bm:AllergySensitive",
      "@type": ["skos:Concept"],
      "inScheme": "bm:DietScheme",
      "broader": "bm:UserProfile",
      "prefLabel": { "ko": "알레르기 이용자", "en": "User with a food allergy" },
      "definition": { "ko": "특정 성분을 먹으면 건강에 해가 되는 이용자. 성분을 확인할 수 없는 가게는 선택지가 되지 못한다." }
    },
    {
      "@id": "bm:allergenLabel",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:DietScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:Place",
      "prefLabel": { "ko": "알레르기 성분 표시", "en": "Allergen labelling" },
      "definition": { "ko": "이 가게가 알레르기 유발 성분을 표시하고 있는가." },
      "note": {
        "ko": "🔴 소규모 식당·제과점은 표시 의무 대상이 아니라 미표시가 흔하다. 그래서 '표시가 없다' 는 '성분이 없다' 가 아니라 '알 수 없다' 이다. 이 둘을 같은 값으로 뭉개면 안 된다 — 그래서 코드가 셋이다."
      },
      "valueRange": { "kind": "코드 — labelled · unlabelled · unknown" },
      "role": "feasibility"
    },
    {
      "@id": "bm:RuleAllergenUnlabelled",
      "@type": ["skos:Concept"],
      "inScheme": "bm:DietScheme",
      "broader": "bm:FeasibilityRule",
      "prefLabel": { "ko": "알레르기 — 성분 미표시", "en": "Allergy — allergens not labelled" },
      "definition": { "ko": "알레르기 성분 표시가 없는 가게는 알레르기 이용자에게 선택지가 되지 못한다." },
      "note": {
        "ko": "🔴 '맛이 없다' 가 아니라 '확인할 수 없다' 라서 막는 것이다. 애매하면 거부한다는 이 저장소의 원칙이 음식에서 특히 그렇다 — 잘못 통과시키면 사람이 다친다. 참기름·참깨가 널리 쓰이고 육수·젓갈처럼 숨은 성분도 많아 눈으로 판단할 수 없다."
      },
      "appliesTo": "bm:AllergySensitive",
      "onClass": "bm:Place",
      "condition": [{ "property": "bm:allergenLabel", "operator": "eq", "constant": "unlabelled" }],
      "verdict": "infeasible",
      "evidenceStatus": "입력미수집"
    }
  ]
}
