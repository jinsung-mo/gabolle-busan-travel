{
  "//": "부산 이동성(걷기·버스) 온톨로지 골격. 기계가 읽는 판이다. 사람용 설명은 docs/ONTOLOGY.md.",
  "//가능과선호": "이 파일은 '가능/불가'(feasibility)만 담는다. '좋다/싫다'(preference)의 가중치는 담지 않는다 — docs/FIELD-STUDY.md 가 짝 비교 실험으로 추정하기로 정했다. 속성에는 '비용함수의 입력이다'(role: cost)라는 사실만 표시하고 계수 자리는 coefficientStatus: 미추정 으로 비워 둔다.",
  "//네임스페이스": "bm: 의 URI 는 지금 브라우저로 열리지 않는다(dereferenceable 하지 않다). 이름이 겹치지 않게 하는 것이 목적이고, 어떤 스크립트도 이 URI 를 가져오지 않는다.",

  "@context": {
    "bm":      "https://lab.ssafy.com/s15-bigdata-dist-sub1/S15P21E201/ns/mobility#",
    "skos":    "http://www.w3.org/2004/02/skos/core#",
    "rdf":     "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs":    "http://www.w3.org/2000/01/rdf-schema#",
    "owl":     "http://www.w3.org/2002/07/owl#",
    "xsd":     "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",
    "qudt":    "http://qudt.org/schema/qudt/",
    "qunit":   "http://qudt.org/vocab/unit/",

    "prefLabel":    { "@id": "skos:prefLabel",   "@container": "@language" },
    "definition":   { "@id": "skos:definition",  "@container": "@language" },
    "note":         { "@id": "skos:note",        "@container": "@language" },
    "broader":      { "@id": "skos:broader",     "@type": "@id" },
    "inScheme":     { "@id": "skos:inScheme",    "@type": "@id" },
    "topConceptOf": { "@id": "skos:topConceptOf","@type": "@id" },

    "onClass":      { "@id": "bm:onClass",       "@type": "@id" },
    "derivedFrom":  { "@id": "bm:derivedFrom",   "@type": "@id" },
    "unit":            "bm:unit",
    "unitIri":      { "@id": "bm:unitIri",       "@type": "@id" },
    "valueRange":      "bm:valueRange",
    "codeList":        "bm:codeList",
    "codeListOpen":    "bm:codeListOpen",
    "kind":            "bm:kind",
    "nullable":        "bm:nullable",
    "minInclusive":    "bm:minInclusive",
    "maxInclusive":    "bm:maxInclusive",
    "role":            "bm:role",
    "status":          "bm:status",
    "coefficientStatus": "bm:coefficientStatus",
    "coefficientSource": "bm:coefficientSource",

    "sourceField":     "bm:sourceField",
    "dataset":         "bm:dataset",
    "field":           "bm:field",
    "xmlElement":      "bm:xmlElement",
    "fieldCandidate":  "bm:fieldCandidate",
    "candidateSource": "bm:candidateSource",
    "expectedFrom":    "bm:expectedFrom",

    "appliesTo":    { "@id": "bm:appliesToProfile", "@type": "@id" },
    "condition":       "bm:condition",
    "property":     { "@id": "bm:property",      "@type": "@id" },
    "parameter":    { "@id": "bm:parameter",     "@type": "@id" },
    "operator":        "bm:operator",
    "constant":        "bm:constant",
    "verdict":         "bm:verdict",
    "evidenceStatus":  "bm:evidenceStatus",

    "value":           "bm:value",
    "valueBasis":      "bm:valueBasis",
    "valueStatus":     "bm:valueStatus"
  },

  "@graph": [

    {
      "@id": "bm:MobilityScheme",
      "@type": "skos:ConceptScheme",
      "prefLabel": { "ko": "부산 이동성 어휘", "en": "Busan Mobility Vocabulary" },
      "definition": {
        "ko": "부산에서 '이 길을 걸을 만한가 / 버스를 탈 만한가' 를 판정하기 위한 개념·속성·가능판정 규칙의 모음.",
        "en": "Concepts, attributes and feasibility rules used to judge whether a Busan route is walkable or bus-servable."
      },
      "note": {
        "ko": "가능/불가만 담는다. 좋다/싫다의 가중치는 짝 비교 실험이 정한다 (docs/FIELD-STUDY.md)."
      },
      "dcterms:license": "OSM 파생분은 ODbL 1.0. 출처별 라이선스는 config/sources.json 에 있다."
    },

    {
      "@id": "bm:NetworkElement",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "topConceptOf": "bm:MobilityScheme",
      "prefLabel": { "ko": "이동 네트워크 요소", "en": "Network element" },
      "definition": {
        "ko": "경로 탐색 그래프를 이루는 것. 사람이 그 위를 지나가거나 그 위에서 갈아탄다.",
        "en": "A thing that forms the routing graph — travelled along or transferred at."
      }
    },
    {
      "@id": "bm:Segment",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:NetworkElement",
      "prefLabel": { "ko": "길 구간", "en": "Segment" },
      "definition": {
        "ko": "OSM way 하나에 대응하는 길의 한 토막. 경사·길이·계단 같은 값이 이 단위로 붙는다.",
        "en": "One stretch of way corresponding to a single OSM way; slope, length and step values attach at this granularity."
      },
      "note": { "ko": "data/staged/segment-slope.ndjson 의 한 줄이 이 클래스의 한 개체다." },
      "status": "수집됨"
    },
    {
      "@id": "bm:BusRoute",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:NetworkElement",
      "prefLabel": { "ko": "버스 노선", "en": "Bus route" },
      "definition": {
        "ko": "정류장을 순서대로 잇는 운행 계통. BIMS 실시간 응답이 노선 단위로 온다.",
        "en": "A service line joining stops in order; BIMS realtime responses arrive per route."
      },
      "note": { "ko": "폴링 중인 노선만 있다. 부산 전 노선이 아니다 — config/routes.json 이 대상을 정한다." },
      "status": "부분수집",
      "expectedFrom": "bims-realtime (config/routes.json 이 정한 노선만)"
    },
    {
      "@id": "bm:BusStop",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:NetworkElement",
      "prefLabel": { "ko": "버스 정류장", "en": "Bus stop" },
      "definition": {
        "ko": "버스를 타고 내리는 지점. 걷기 구간과 버스 노선이 여기서 이어진다.",
        "en": "A boarding point where walking segments and bus routes meet."
      },
      "status": "부분수집",
      "expectedFrom": "bims-realtime (폴링한 노선의 정류장만)"
    },
    {
      "@id": "bm:Barrier",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:NetworkElement",
      "prefLabel": { "ko": "차단물", "en": "Barrier" },
      "definition": {
        "ko": "지나가는 것을 물리적으로 막거나 제한하는 것 — 계단·차량차단봉·문·요금소·턱.",
        "en": "Something that physically blocks or restricts passage — steps, bollards, gates, toll booths, kerbs."
      },
      "note": {
        "ko": "원시 수집분은 data/raw/pbf/barrier.ndjson 에 있으나 구간에 붙인 staged 산출물이 아직 없다. 계단은 bm:Segment 쪽에서 topic=stairs 로 이미 다뤄진다."
      },
      "status": "부분수집",
      "expectedFrom": "osm-korea-pbf (data/raw/pbf/barrier.ndjson — staged 산출물 없음)"
    },

    {
      "@id": "bm:EnvironmentFeature",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "topConceptOf": "bm:MobilityScheme",
      "prefLabel": { "ko": "주변 환경 요소", "en": "Environment feature" },
      "definition": {
        "ko": "구간 위에 있지 않지만 걷는 경험을 바꾸는 것. 경로 그래프의 일부는 아니다.",
        "en": "Something not on the segment itself but which changes the walking experience; not part of the routing graph."
      }
    },
    {
      "@id": "bm:Building",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:EnvironmentFeature",
      "prefLabel": { "ko": "건물", "en": "Building" },
      "definition": {
        "ko": "높이(또는 층수)를 가진 구조물. 태양 고도와 함께 쓰면 그림자 길이가 나온다.",
        "en": "A structure with a height (or storey count); combined with solar elevation it yields shadow length."
      },
      "note": {
        "ko": "OSM 원본에 height·building:levels 가 일부 있다는 것은 실측했다(docs/WALKABILITY.md 2.2). 다만 부산 건물을 뽑은 staged 산출물이 아직 없다."
      },
      "status": "부분수집",
      "expectedFrom": "osm-korea-pbf (height·building:levels 태그) / molit-gis-building"
    },
    {
      "@id": "bm:ShadeSource",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:EnvironmentFeature",
      "prefLabel": { "ko": "그늘 원천", "en": "Shade source" },
      "definition": {
        "ko": "구간에 그늘을 만드는 것. 여름 부산에서 그늘 유무는 쾌적함이 아니라 걷느냐 마느냐를 가른다.",
        "en": "Anything that casts shade onto a segment; in a Busan summer this decides whether people walk at all."
      },
      "status": "미수집",
      "expectedFrom": "busan-street-trees, molit-gis-building"
    },
    {
      "@id": "bm:StreetTreeSection",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:ShadeSource",
      "prefLabel": { "ko": "가로수 구간", "en": "Street tree section" },
      "definition": {
        "ko": "한 도로의 시점~종점 사이에 가로수가 심긴 구간. 수종과 그루 수가 함께 온다.",
        "en": "A stretch of one road, from start point to end point, planted with street trees, with species and counts."
      },
      "note": {
        "ko": "🔴 아직 받지 않았다. 필드 이름을 지어내지 않는다 — 실제 응답을 받은 뒤에 field 를 채운다. docs/WALKABILITY.md 2.1 이 포털 화면에서 적어둔 후보만 fieldCandidate 로 남겨 둔다. 계산으로는 절대 못 만드는 데이터다."
      },
      "status": "미수집",
      "expectedFrom": "busan-street-trees",
      "fieldCandidate": ["loc_nm", "sec_timepoint", "sec_endpoint", "plant_distance", "total"],
      "candidateSource": "docs/WALKABILITY.md 2.1 (포털 화면 기록 — 실제 응답으로 확인되지 않았다)"
    },
    {
      "@id": "bm:BuildingShadow",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:ShadeSource",
      "prefLabel": { "ko": "건물 그림자", "en": "Building shadow" },
      "definition": {
        "ko": "건물 높이와 태양 고도로 계산되는 그늘. 시각에 따라 답이 달라진다 — 같은 구간이 정오에는 뙤약볕, 늦은 오후에는 그늘이다.",
        "en": "Shade computed from building height and solar elevation; the answer changes with time of day."
      },
      "note": { "ko": "계산으로 만든다. 사진이 필요 없다. 아직 구현하지 않았다." },
      "status": "미수집",
      "expectedFrom": "molit-gis-building (없으면 OSM building:levels 로 시작)"
    },

    {
      "@id": "bm:UserProfile",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "topConceptOf": "bm:MobilityScheme",
      "prefLabel": { "ko": "이동 제약 프로파일", "en": "Mobility constraint profile" },
      "definition": {
        "ko": "이동 능력의 묶음. 이 온톨로지에서 프로파일은 '무엇이 불가능한가' 만 정하고 '무엇을 더 좋아하는가' 는 정하지 않는다.",
        "en": "A bundle of mobility capability; here a profile declares only what is impossible, never what is preferred."
      },
      "note": {
        "ko": "이 프로파일에 직접 붙은 규칙은 네 하위 프로파일 전부에 적용된다."
      }
    },
    {
      "@id": "bm:Wheelchair",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:UserProfile",
      "prefLabel": { "ko": "휠체어", "en": "Wheelchair" },
      "definition": {
        "ko": "바퀴로 이동하며 단차를 넘을 수 없는 이용자. 계단은 통과 불가이고 경사와 유효폭에 상한이 있다.",
        "en": "A wheeled user who cannot cross a step; stairs are impassable and slope and clear width are capped."
      }
    },
    {
      "@id": "bm:Stroller",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:UserProfile",
      "prefLabel": { "ko": "유모차", "en": "Stroller" },
      "definition": {
        "ko": "유모차를 밀고 걷는 이용자. 들어 올리면 계단을 넘을 수 있으나 판정에서는 불가로 둔다 — 통과 가능 여부가 동반자 수에 달려 있어 우리가 관측할 수 없다.",
        "en": "A user pushing a stroller; steps are treated as infeasible because passability depends on companions we cannot observe."
      }
    },
    {
      "@id": "bm:Elderly",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:UserProfile",
      "prefLabel": { "ko": "고령자", "en": "Elderly" },
      "definition": {
        "ko": "계단과 오르막을 오를 수는 있으나 누적량에 상한이 있는 이용자. 계단은 '있다/없다' 가 아니라 '몇 단인가' 로 걸린다.",
        "en": "A user who can climb but only up to a cumulative limit; steps matter by count, not by presence."
      }
    },
    {
      "@id": "bm:Default",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:UserProfile",
      "prefLabel": { "ko": "기본", "en": "Default" },
      "definition": {
        "ko": "특별한 이동 제약을 선언하지 않은 이용자. 물리적으로 보행이 금지된 곳(자동차 전용도로)만 불가이고, 경사와 계단은 불가가 아니라 비용이다.",
        "en": "A user with no declared constraint; only pedestrian-banned ways are infeasible, while slope and steps are costs rather than blocks."
      },
      "note": {
        "ko": "이 프로파일의 유일한 불가 조건은 bm:UserProfile 에 붙은 bm:RuleMotorFootBan 이다. 그것이 설계 의도다 — 기본 이용자에게는 '싫다' 를 '못 간다' 로 바꾸지 않는다."
      }
    },

    {
      "@id": "bm:Attribute",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "topConceptOf": "bm:MobilityScheme",
      "prefLabel": { "ko": "속성", "en": "Attribute" },
      "definition": {
        "ko": "클래스의 개체가 갖는 값. 값을 갖는 것은 전부 단위 또는 값 범위를 함께 선언한다 — 단위 없는 숫자는 다음 사람이 반드시 잘못 읽는다.",
        "en": "A value held by an instance; every value-bearing attribute declares a unit or a value range."
      }
    },

    {
      "@id": "bm:osmWayId",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:Segment",
      "prefLabel": { "ko": "OSM way 식별자", "en": "OSM way id" },
      "definition": { "ko": "이 구간의 원본 OpenStreetMap way 번호. 재수집해도 같은 구간을 다시 찾을 수 있는 유일한 열쇠다." },
      "valueRange": { "kind": "정수", "minInclusive": 1, "nullable": false },
      "role": "identifier",
      "status": "수집됨",
      "sourceField": [{ "dataset": "data/staged/segment-slope.ndjson", "field": "id" }]
    },
    {
      "@id": "bm:networkTopic",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:Segment",
      "prefLabel": { "ko": "네트워크 분류", "en": "Network topic" },
      "definition": { "ko": "구간을 어느 추출 주제에서 뽑았는가. PBF 추출 단계가 붙인 값이고 OSM 태그가 아니다." },
      "codeList": ["road", "walk", "stairs"],
      "codeListOpen": false,
      "role": "feasibility",
      "status": "수집됨",
      "sourceField": [{ "dataset": "data/staged/segment-slope.ndjson", "field": "topic" }]
    },
    {
      "@id": "bm:osmHighwayClass",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:Segment",
      "prefLabel": { "ko": "OSM 도로 등급", "en": "OSM highway class" },
      "definition": { "ko": "OSM highway 태그의 값. 보행 금지 판정의 유일한 근거이며 지금 staged 에 실제로 들어 있는 값이다." },
      "codeList": ["motorway", "motorway_link", "trunk", "trunk_link", "primary", "secondary", "tertiary", "residential", "unclassified", "service", "living_street", "pedestrian", "footway", "path", "steps", "track", "cycleway", "corridor", "elevator", "busway", "construction", "proposed"],
      "codeListOpen": true,
      "note": { "ko": "codeList 는 관측된 값이고 허용 목록이 아니다 — OSM 은 새 값을 계속 만든다. null 도 관측된다." },
      "role": "feasibility",
      "status": "수집됨",
      "sourceField": [{ "dataset": "data/staged/segment-slope.ndjson", "field": "highway" }]
    },
    {
      "@id": "bm:roadName",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:Segment",
      "prefLabel": { "ko": "도로명", "en": "Road name" },
      "definition": { "ko": "구간의 이름. 사람에게 경로를 설명할 때만 쓰고 판정에는 쓰지 않는다." },
      "valueRange": { "kind": "자유 문자열", "nullable": true },
      "role": "descriptive",
      "status": "수집됨",
      "sourceField": [{ "dataset": "data/staged/segment-slope.ndjson", "field": "name" }]
    },
    {
      "@id": "bm:lengthM",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:Segment",
      "prefLabel": { "ko": "구간 길이", "en": "Segment length" },
      "definition": { "ko": "구간을 이루는 좌표열의 지표면 거리 합. 대권거리로 계산한 실제 도상거리다." },
      "unit": "m",
      "unitIri": "qunit:M",
      "valueRange": { "minInclusive": 0, "kind": "실수" },
      "role": "cost",
      "coefficientStatus": "미추정",
      "coefficientSource": "process/choice-fit.mjs (짝 비교 응답이 있을 때)",
      "status": "수집됨",
      "sourceField": [{ "dataset": "data/staged/segment-slope.ndjson", "field": "length" }]
