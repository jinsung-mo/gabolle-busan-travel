      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:Station",
      "prefLabel": { "ko": "역 이름", "en": "Station name" },
      "definition": { "ko": "역의 한국어 이름. 사람에게 보여줄 때 쓴다." },
      "note": { "ko": "값이 비는 줄이 있다 — 부산 밖(양산)에 있어 부산교통공사 역 목록에 안 붙은 출입구다. 붙었는지는 같은 파일의 joined 가 말한다." },
      "valueRange": { "kind": "자유 문자열", "nullable": true },
      "role": "descriptive",
      "status": "수집됨",
      "sourceField": [{ "dataset": "data/staged/subway-entrance.ndjson", "field": "stationName" }]
    },
    {
      "@id": "bm:stationLineNumbers",
