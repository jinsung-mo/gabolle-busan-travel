    },
    {
      "@id": "bm:exitLabel",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:StationEntrance",
      "prefLabel": { "ko": "출입구 표기", "en": "Entrance label" },
      "definition": { "ko": "OSM 에 적힌 출입구 안내 원문. 번호 추출이 맞았는지 사람이 눈으로 대조할 때 쓴다." },
      "valueRange": { "kind": "자유 문자열", "nullable": true },
      "role": "descriptive",
      "status": "수집됨",
      "sourceField": [{ "dataset": "data/staged/subway-entrance.ndjson", "field": "exitLabel" }]
    },
    {
      "@id": "bm:exitElevatorAvailable",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:StationEntrance",
      "prefLabel": { "ko": "출입구 승강기 있음", "en": "Entrance has elevator" },
      "definition": { "ko": "이 출입구에 엘리베이터가 있는가. 바퀴 이용자에게 지하 역사는 승강기가 없으면 '힘들다' 가 아니라 '못 간다' 다." },
      "note": {
        "ko": "🔴 값이 셋이다 — 참·거짓·모름(null). 역을 못 붙였거나 출구 번호를 모르면 거짓이 아니라 모름이고, 산출물이 그 구분을 이미 지키고 있다. 🔴 거짓의 의미는 아직 확인하지 못했다: 출입구 번호가 안 적힌 엘리베이터가 따로 세어져 있어서, 거짓이 '없다' 인지 '번호가 안 적혔다' 인지 갈린다. 그래서 이 값을 참조하는 규칙은 evidenceStatus 검증필요 다 — bm:lowFloorAvailable 과 같은 처리다."
      },
      "codeList": [true, false],
      "codeListOpen": false,
      "role": "feasibility",
      "status": "수집됨",
      "sourceField": [{ "dataset": "data/staged/subway-entrance.ndjson", "field": "exitElevator" }]
    },

    {
      "@id": "bm:travelerProfile",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:Traveler",
      "rangeClass": "bm:UserProfile",
      "prefLabel": { "ko": "여행자의 이동 제약", "en": "Traveller's mobility profile" },
      "definition": { "ko": "이 여행자가 어느 이동 제약 프로파일인가. 가능판정 규칙은 프로파일에 붙어 있으므로 이 관계로 사람과 규칙이 이어진다." },
      "valueRange": { "kind": "참조 (bm:UserProfile 의 하위 개념 하나)", "nullable": false },
      "role": "feasibility"
    },
    {
      "@id": "bm:hasWheeledLuggage",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:Traveler",
      "prefLabel": { "ko": "바퀴 달린 짐 있음", "en": "Has wheeled luggage" },
      "definition": { "ko": "지금 캐리어를 끌고 있는가. 여행자는 체크인 전과 체크아웃 후에 반드시 이 상태가 되고, 그때 계단과 경사의 뜻이 달라진다." },
      "note": {
        "ko": "🔴 이 값이 계단을 '불가' 로 만드는지 '비싼 것' 으로 만드는지는 아직 정하지 않았다. 그래서 이 속성을 참조하는 규칙이 없다 — 고령자 계단 상한과 같은 자리에 멈춰 있다. 지금 선언해 두는 이유는 자료형이 아니라 실험 때문이다: 짝 비교 문항에 '캐리어를 끌고 있다' 조건이 없으면 그 계수는 영영 못 뽑는다. 현장 실험은 한 번뿐이다 (docs/FIELD-STUDY.md 5절)."
      },
      "codeList": [true, false],
      "codeListOpen": false,
      "role": "feasibility"
    },

    {
      "@id": "bm:itineraryDate",
