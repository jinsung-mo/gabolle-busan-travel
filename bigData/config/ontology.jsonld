    },
    {
      "@id": "bm:RuleStrollerSlope",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:FeasibilityRule",
      "prefLabel": { "ko": "유모차 — 경사 상한 초과", "en": "Stroller — slope over limit" },
      "definition": { "ko": "대표 경사가 유모차 상한을 넘는 구간은 지날 수 없다." },
      "appliesTo": "bm:Stroller",
