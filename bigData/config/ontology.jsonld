      "prefLabel": { "ko": "상점·시장", "en": "Shops and markets" },
      "definition": { "ko": "사러 가는 곳. 짐이 늘어나는 지점이라 이 뒤의 Leg 은 캐리어 상태가 바뀔 수 있다." },
      "codeList": ["amenity=marketplace", "shop=supermarket", "shop=convenience", "shop=department_store", "shop=mall", "shop=general", "shop=variety_store", "shop=clothes", "shop=cosmetics", "shop=gift", "shop=books", "shop=jewelry", "shop=shoes", "shop=seafood", "shop=butcher", "shop=greengrocer"],
