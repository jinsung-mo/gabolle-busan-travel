      "broader": "bm:Attribute",
      "onClass": "bm:Station",
      "prefLabel": { "ko": "환승역 여부", "en": "Is transfer station" },
      "definition": { "ko": "이 역에서 노선을 갈아탈 수 있는가. 참이면 환승 통로 도보거리가 이동 비용에 들어와야 한다." },
      "codeList": [true, false],
      "codeListOpen": false,
      "role": "descriptive",
      "status": "수집됨",
      "sourceField": [{ "dataset": "data/staged/subway-entrance.ndjson", "field": "stationIsTransfer" }]
    },
    {
      "@id": "bm:stationTransferWalkM",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:Station",
      "prefLabel": { "ko": "환승 통로 도보거리", "en": "Transfer walking distance" },
      "definition": { "ko": "이 역에서 노선을 갈아탈 때 실제로 걷는 거리. 이것이 없으면 환승 1회가 전부 같은 비용이 된다." },
      "note": { "ko": "🔴 아직 없다. 서울은 공개돼 있으나 부산 대응물을 못 찾았다. staged 산출물에 같은 이름의 칸이 이미 열려 있지만 전 줄이 비어 있어 sourceField 로 올리지 않는다 — 값이 하나도 없는 칸을 출처로 적으면 있는 것처럼 읽힌다." },
      "unit": "m",
      "unitIri": "qunit:M",
      "valueRange": { "minInclusive": 0, "kind": "실수", "nullable": true },
      "role": "cost",
      "coefficientStatus": "미추정",
      "coefficientSource": "process/choice-fit.mjs (짝 비교 응답이 있을 때)",
      "status": "미수집",
      "expectedFrom": "btc-transfer-walk (공개 데이터가 없어 환승역을 손으로 재는 것이 현실적인 길이다)"
    },
    {
      "@id": "bm:stationFirstTrainTime",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:Station",
      "prefLabel": { "ko": "첫차 시각", "en": "First train time" },
      "definition": { "ko": "이 역에서 첫 열차가 떠나는 시각. 이른 아침 일정이 성립하는가를 가른다." },
      "note": { "ko": "🔴 아직 없다. 값의 형식도 정하지 않는다 — 실제 응답을 받은 뒤에 정한다. staged 산출물에 빈 칸만 열려 있다." },
      "valueRange": { "kind": "시각 (형식 미확인)", "nullable": true },
      "role": "feasibility",
      "status": "미수집",
      "expectedFrom": "btc-timetable (활용신청 승인 2026-09-06, 아직 호출하지 않음)"
    },
