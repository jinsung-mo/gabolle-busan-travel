      "codeList": ["amenity=restaurant", "amenity=cafe", "amenity=fast_food", "amenity=food_court", "amenity=pub", "amenity=bar", "amenity=ice_cream", "shop=bakery", "shop=pastry", "shop=confectionery", "shop=deli"],
