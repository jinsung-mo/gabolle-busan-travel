    },
    {
      "@id": "bm:exitRef",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:StationEntrance",
      "prefLabel": { "ko": "출구 번호", "en": "Exit number" },
      "definition": { "ko": "현장 표지판에 적힌 출구 번호. 승강기 데이터에 좌표가 없어서 이 번호로 맞붙인다 — 그 조인이 되는 유일한 이유다." },
      "unit": "count",
      "valueRange": { "minInclusive": 1, "kind": "정수", "nullable": true },
      "role": "identifier",
      "status": "수집됨",
