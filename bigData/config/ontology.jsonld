    {
      "@id": "bm:Station",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:NetworkElement",
      "prefLabel": { "ko": "도시철도 역", "en": "Metro station" },
      "definition": {
        "ko": "부산 도시철도의 역 하나. 호선·환승 여부·첫차막차처럼 출구가 아니라 역 전체에 붙는 값을 갖는다.",
        "en": "One Busan metro station; carries values that belong to the station as a whole rather than to a single exit."
      },
      "note": {
        "ko": "🔴 bm:Waypoint 가 아니다. 역은 갈 수 있는 지점이 아니라 '출구 여러 개를 묶은 것' 이고, 여기까지의 거리를 역 중심점으로 재면 매번 틀린다 — 서면·부산역은 출구끼리 수백 m 벌어진다. 그래서 역 중심점 좌표(stationLat·stationLon)는 일부러 속성으로 올리지 않았다. 거리를 재는 단위는 bm:StationEntrance 다."
      },
      "status": "수집됨",
      "sourceField": [{ "dataset": "data/staged/subway-entrance.ndjson", "field": "stationNo" }]
    },
    {
      "@id": "bm:StationEntrance",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "broader": ["bm:NetworkElement", "bm:Waypoint"],
      "prefLabel": { "ko": "도시철도 출입구", "en": "Metro station entrance" },
      "definition": {
        "ko": "역의 출입구 하나. 좌표를 갖는 단위이고, 걷기 구간과 도시철도가 실제로 이어지는 지점이다.",
        "en": "A single station exit; the unit that carries coordinates and where walking actually meets the metro."
      },
      "note": {
        "ko": "data/staged/subway-entrance.ndjson 의 한 줄이 이 클래스의 한 개체다 (그 파일의 class 필드가 이미 StationEntrance 라고 적고 있었는데 온톨로지에 등록되어 있지 않았다). 한 줄에 역 단위 값(station*)이 함께 실려 있지만 그것은 bm:Station 의 속성이다. 상위가 둘인 이유는 bm:BusStop 과 같다."
      },
      "status": "수집됨",
      "sourceField": [{ "dataset": "data/staged/subway-entrance.ndjson", "field": "class" }]
    },

    {
      "@id": "bm:TravelMode",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "topConceptOf": "bm:MobilityScheme",
      "prefLabel": { "ko": "이동 수단", "en": "Travel mode" },
      "definition": {
        "ko": "이동 한 토막을 무엇으로 가는가. 한 Leg 은 수단 하나만 갖는다 — 수단이 바뀌면 Leg 이 바뀐다.",
        "en": "What a single Leg is travelled by; one Leg carries exactly one mode."
      },
      "note": { "ko": "수집 대상이 아니라 열거 개념이라 status 가 없다. 각 수단이 실제로 어떤 데이터를 갖고 있는지는 하위 개념의 note 에 적었다." }
    },
    {
      "@id": "bm:ModeWalk",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:TravelMode",
      "prefLabel": { "ko": "걷기", "en": "Walking" },
      "definition": { "ko": "걸어서 가는 것. 이 수단일 때만 Leg 이 bm:Segment 를 갖고, 경사·계단·그늘 판정이 걸린다." },
      "note": { "ko": "데이터가 가장 두꺼운 수단이다 — 구간별 경사가 이미 있다." }
    },
    {
      "@id": "bm:ModeBus",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:TravelMode",
      "prefLabel": { "ko": "버스", "en": "Bus" },
      "definition": { "ko": "시내버스를 타고 가는 것. 끝점은 bm:BusStop 이고 어느 노선인지는 bm:legBusRoute 가 가리킨다." },
      "note": { "ko": "BIMS 실시간 폴링으로 관측 중이다. 소급 수집이 안 되는 유일한 수단이다." }
    },
    {
      "@id": "bm:ModeMetro",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:TravelMode",
      "prefLabel": { "ko": "도시철도", "en": "Metro" },
      "definition": { "ko": "부산 도시철도를 타고 가는 것. 끝점은 역이 아니라 bm:StationEntrance 다." },
      "note": { "ko": "출구·승강기·승하차인원은 받았고 시각표(첫차·막차)와 환승 통로 도보거리는 아직 없다." }
    },
    {
      "@id": "bm:ModeTaxi",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:TravelMode",
      "prefLabel": { "ko": "택시", "en": "Taxi" },
      "definition": { "ko": "택시로 가는 것. 걷기가 불가하다고 판정된 구간의 탈출구다." },
      "note": { "ko": "🔴 이 수단을 뒷받침하는 데이터가 아직 하나도 없다. 열거값만 열어 두는 것이고, 소요시간·요금을 지어내지 않는다." }
    },

    {
      "@id": "bm:Traveler",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "topConceptOf": "bm:MobilityScheme",
      "prefLabel": { "ko": "여행자", "en": "Traveller" },
      "definition": {
        "ko": "일정을 갖는 사람. 이동 제약(bm:UserProfile)을 '가진다' — 프로파일이 곧 사람은 아니다.",
        "en": "The person who holds an itinerary; a traveller has a mobility profile rather than being one."
      },
      "note": {
        "ko": "🔴 bm:UserProfile 을 대체하지 않는다. 프로파일은 '무엇이 불가능한가' 만 말하는 재사용 가능한 묶음이고, 여행자는 그 묶음에 더해 그날의 상태(짐이 있는가 같은 것)를 갖는다. 사람의 정보는 이 온톨로지가 담지 않는다 — docs/FIELD-STUDY.md 3절이 이름·연락처·GPS 궤적을 받지 않기로 정했다. 수집 대상이 아니라 구조 개념이라 status 가 없다."
      }
    },
    {
      "@id": "bm:Itinerary",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "topConceptOf": "bm:MobilityScheme",
      "prefLabel": { "ko": "하루 일정", "en": "Itinerary" },
      "definition": {
        "ko": "한 여행자의 하루치 이동 계획. 순서가 있는 bm:Leg 의 나열이고, 날짜를 갖는다.",
        "en": "One traveller's plan for a day: an ordered sequence of Legs, carrying a date."
      },
      "note": { "ko": "경로 탐색 결과이지 수집물이 아니라 status 가 없다. 날짜를 갖는 이유는 그림자와 영업시간이 날짜·요일에 따라 달라지기 때문이다." }
    },
    {
      "@id": "bm:Leg",
      "@type": ["skos:Concept", "rdfs:Class"],
      "inScheme": "bm:MobilityScheme",
      "topConceptOf": "bm:MobilityScheme",
      "prefLabel": { "ko": "이동 한 토막", "en": "Leg" },
      "definition": {
        "ko": "출발 지점에서 도착 지점까지 수단 하나로 가는 이동 한 번. 걷기 Leg 은 bm:Segment 여럿을 묶고, 버스·도시철도 Leg 은 노선과 정류장·출구를 묶는다.",
        "en": "One movement from one waypoint to another by a single mode; a walking Leg bundles several Segments."
      },
      "note": {
        "ko": "🔴 이 클래스가 접착제다. 구간별로 만든 값(경사·그늘·경치)은 Leg 으로 묶여야 '이 이동이 할 만한가' 가 되고, Leg 은 다시 bm:Itinerary 로 묶여야 '이 하루가 되는가' 가 된다. 그래서 bm:Itinerary → bm:Leg → bm:Segment 로 내려가는 길이 끊기면 test/verify-ontology.mjs 가 종료 코드 1 로 막는다. 경로 탐색 결과라 status 가 없다."
      }
    },

    {
      "@id": "bm:Attribute",
      "@type": ["skos:Concept"],
      "inScheme": "bm:MobilityScheme",
      "topConceptOf": "bm:MobilityScheme",
      "prefLabel": { "ko": "속성", "en": "Attribute" },
      "definition": {
        "ko": "클래스의 개체가 갖는 값. 값을 갖는 것은 전부 단위 또는 값 범위를 함께 선언한다 — 단위 없는 숫자는 다음 사람이 반드시 잘못 읽는다.",
        "en": "A value held by an instance; every value-bearing attribute declares a unit or a value range."
      }
    },

