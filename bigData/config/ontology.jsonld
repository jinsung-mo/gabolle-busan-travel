    {
      "@id": "bm:slopeP90",
      "@type": ["skos:Concept", "rdf:Property"],
      "inScheme": "bm:MobilityScheme",
      "broader": "bm:Attribute",
      "onClass": "bm:Segment",
      "prefLabel": { "ko": "경사 90분위", "en": "Slope p90" },
      "definition": { "ko": "구간을 따라 잰 경사 표본의 90분위값. 이 구간의 대표 경사다." },
      "note": {
        "ko": "🔴 대표값은 최댓값이 아니라 p90 이다 — 최댓값은 잡음 표본 하나에 끌려간다 (bigData/CLAUDE.md 7절). 어떤 기준선(baseline)으로 쟀는지는 data/staged/_slope-summary.json 이 갖고 있고, 그 기준선은 손으로 정하지 않고 process/calibrate-slope.mjs 가 실측으로 정한다."
      },
      "unit": "ratio",
      "valueRange": { "minInclusive": 0, "kind": "무차원 비 (수직/수평). 0.0833 이면 8.33% 다" },
      "role": "cost",
      "coefficientStatus": "미추정",
      "coefficientSource": "process/choice-fit.mjs (짝 비교 응답이 있을 때)",
      "status": "수집됨",
      "sourceField": [{ "dataset": "data/staged/segment-slope.ndjson", "field": "p90Slope" }]
    },
