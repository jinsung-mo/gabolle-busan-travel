      "prefLabel": { "ko": "이 출입구의 역", "en": "Station of entrance" },
      "definition": { "ko": "이 출입구가 어느 역의 것인가. 역 하나에 출입구가 여럿 붙는다." },
      "note": { "ko": "산출물은 한 줄에 역과 출입구를 함께 담고 있다(비정규화). 그 줄의 station* 값들이 이 관계의 반대편이다." },
      "valueRange": { "kind": "참조 (bm:Station 하나)", "nullable": true },
      "role": "identifier",
