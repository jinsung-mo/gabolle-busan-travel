# 복사해서 .env 로 쓴다.  cp .env.example .env
#
# 🔴 .env 는 커밋되지 않는다 (.gitignore). 키를 여기 example 에 적지 않는다.

# 공공데이터포털 — BIMS 실시간 버스, TourAPI
# https://www.data.go.kr 회원가입 → 활용신청 → "일반 인증키(Decoding)" 를 넣는다
DATA_GO_KR_KEY=

# BIMS 요청주소. 활용신청 화면에 뜨는 것을 그대로 붙인다 (오퍼레이션마다 다르다)
BIMS_ENDPOINT=

# 폴링할 노선. 비우면 전체 (오퍼레이션이 지원할 때만)
BIMS_ROUTES=

# Mapillary 거리 이미지 — https://www.mapillary.com/developer
MAPILLARY_TOKEN=
