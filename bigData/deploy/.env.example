# 팀원 6명의 공공데이터포털 인증키 (S15P21E201-633)
#
# 🔴 이 파일을 복사해 `.env` 로 만들고 값을 채운다. `.env` 는 커밋되지 않는다
#    (bigData/.gitignore). **채운 파일을 저장소에 올리지 않는다.**
#
# 🔴 인증키는 포털 마이페이지에 **두 가지 형태**로 나온다 — Encoding 과 Decoding.
#    어느 쪽을 넣어도 된다. 수집기가 형태를 알아보고 필요하면 되돌린다
#    (collect/bims-poll.mjs). 사람이 기억해야 할 것을 하나 줄인 자리다.
#
# 한도는 **계정당이 아니라 오퍼레이션당** 하루 10,000회다. 노선별 실시간 위치는
# /busInfoByRouteId 하나에서만 나오므로, 이 배포가 쓰는 예산은 키마다 그 10,000회다.

KEY_RLEADERJOON=
KEY_MASDF13=
KEY_YEASEUNG=
KEY_JINMIRI=
KEY_MOJINSEONG=
KEY_KOJIHYEOK=

# 아침 점검(매일 05:00 KST)을 보낼 MatterMost Incoming Webhook 주소.
#
# 🔴 젠킨스가 배포 알림에 쓰는 것과 **같은 주소를 써도 된다.** 젠킨스에는
#    `mattermost-webhook` 이라는 이름의 Secret text 로 들어 있다
#    (backend/Jenkinsfile 머리말). 다른 채널로 보내고 싶으면 그 채널의 웹훅을
#    새로 만들어 넣는다.
#
# 비어 있으면 점검은 화면에만 나오고 아무 데도 안 간다 — 조용히 성공한 척하지 않는다.
MATTERMOST_WEBHOOK=
