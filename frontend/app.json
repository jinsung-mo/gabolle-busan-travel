{
  "expo": {
    "name": "GABOLLE",
    "slug": "gabolle",
    "scheme": "gabolle",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gabolle.app"
    },
    "android": {
      "package": "com.gabolle.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-localization",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치 주변의 여행지 안내와 방문 확인을 위해 위치를 사용합니다. 거부해도 일정 생성은 이용할 수 있습니다."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "메뉴와 안내문을 촬영해 번역하기 위해 카메라를 사용합니다. 촬영 이미지는 기기에 저장하지 않습니다.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "여행 기록에 올릴 사진을 고르기 위해 사진첩을 사용합니다. 고른 사진만 올라가고, 다른 사진은 읽지 않습니다.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc9408fc-1e33-43e7-bec7-4e051920958e"
      }
    },
    "owner": "yeaseunglee"
  }
}
