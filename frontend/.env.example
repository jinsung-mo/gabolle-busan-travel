# Web development backend. Do not include /api/v1 or a trailing slash.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Expo Go and physical devices cannot reach the development PC through localhost.
# Replace the example address with the PC's LAN address; never commit credentials here.
# EXPO_PUBLIC_API_BASE_URL=http://192.0.2.10:8080

# OAuth callback base URL. Must match what is registered in each provider console and
# in the backend GABOLLE_OAUTH_ALLOWED_REDIRECT_URIS. Defaults to the deployed host.
# EXPO_PUBLIC_OAUTH_CALLBACK_BASE_URL=https://j15e201.p.ssafy.io

# OAuth public client identifiers. The backend still performs the provider token exchange.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# EXPO_PUBLIC_NAVER_CLIENT_ID=
# EXPO_PUBLIC_KAKAO_CLIENT_ID=
# 카카오 개발자 콘솔의 JavaScript 키. 웹 지도 도메인 등록도 함께 필요합니다.
# EXPO_PUBLIC_KAKAO_MAP_JS_KEY=

# Optional deployment identity. It is hidden unless the URL contains
# `?build-debug=1` (or EXPO_PUBLIC_SHOW_BUILD_INFO=1 is set).
EXPO_PUBLIC_BUILD_SHA=
EXPO_PUBLIC_BUILD_REF=
EXPO_PUBLIC_SHOW_BUILD_INFO=0
