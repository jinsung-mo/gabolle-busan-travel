DATABASE_URL="file:./dev.db"
PORT=4000

# https://developers.kakao.com 에서 발급받은 REST API 키
# 없으면 이동시간은 하버사인 거리 추정치로 자동 폴백됩니다.
# [주의 - 2026-08-25 실측] 현재 이 값이 실제로는 JavaScript 키로 등록돼 있으면, 카카오모빌리티
# 자동차 길찾기는 계속 401로 실패해 추정치로 폴백된다(Mobility는 별도 REST 키 상품이라 우회 불가).
# 대중교통·장소검색은 KAKAO_JS_ORIGIN 워크어라운드로 동작하지만, 정확한 REST API 키로 교체하는 것이
# 근본 해결책이다(Kakao Developers 콘솔 → 앱 → 앱 키 → REST API 키).
KAKAO_REST_API_KEY=

# 위 키가 REST API 키가 아니라 JavaScript 키일 때만 필요한 워크어라운드.
# 그 키에 등록된 웹 플랫폼 도메인(보통 프론트엔드 dev 서버 주소)을 넣으면
# 카카오 로컬검색·대중교통(publictraffic) API가 KA 헤더로 그 도메인인 척 호출해 통과한다.
# 진짜 REST API 키로 교체하면 이 값은 더 이상 필요 없다.
KAKAO_JS_ORIGIN=http://localhost:5173

# https://data.go.kr 활용신청 후 발급받은 일반 인증키(Encoding)
# KorService2(국문)/EngService2(영문) 공통
# 없으면 `npm run import:tourapi`(관광공사 데이터 배치 임포트)만 사용 불가하고 나머지는 정상 동작
TOUR_API_KEY=
