# 장부 worktree. 작업 브랜치에 섞이면 안 된다 (axmap init 도 이 줄을 넣는다)
.axmap/

# content hash 기반 LLM 분석 캐시. 파일에서 다시 만들어진다
app/.cache/

node_modules/

# 공개 주소에 무엇을 올려놨는지. 자격증명이 들어 있으므로 절대 커밋하지 않는다
# (tools/serve-public.mjs)
.axmap-public.json
.axmap-public.log

# 모델 비교 하네스가 만드는 기록. 돌릴 때마다 덮어써진다
app/eval/out/

# 벤치 산출물 — 스크린샷은 크고 매번 새로 만든다
docs/bench-runs/*/shots/

# 실행 산출물 — 돌릴 때마다 바뀌어 rebase 를 막는다
.axmap-agent.log
.axmap-smoke.log
corpus-data/
.axmap-bus-seen.json

# Java / Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Node / React
node_modules/
dist/
build/
.vite/
coverage/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key

# IDE
.idea/
*.iml
.vscode/settings.json
.classpath
.project
.factorypath

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# axMap 은 이제 별도 저장소에 있다 (rleaderjoon/axmap).
# 분리 전에 clone 한 PC 에는 이 폴더가 디스크에 남아 있는데, 추적하지 않는다.
# 사본은 ci/axmap/ 이고 그건 vendor 명령이 만든다.
/axmap/

# 소상공인 상가정보 원본 CSV (82MB) — 저장소에 넣지 않는다. 각자 내려받는다.
bigData/data/sbiz/*.csv

# 데이터 흐름도의 그림 파일은 **만들어지는 것**이라 커밋하지 않는다.
# 원본은 파트마다 있는 `dataflow.json` 이고, 이것은 그것들을 모은 결과다.
# 커밋하면 두 벌이 되고, 두 벌이 되는 순간 어느 쪽이 진짜인지 아무도 모르게 된다.
# 다시 만들려면:  node ci/status/flow/build-flow.mjs
ci/status/flow/graph.json
